<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:orientation="vertical"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_floating"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/tab_indicator_yellow"
            android:backgroundTint="#484850" />

        <!-- Title matching Screenshot 2: "Download video as" -->
        <TextView
            android:id="@+id/snaptube_sheet_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:text="Download video as"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif" />

        <!-- Video Preview Card: Thumbnail + Title + Source -->
        <LinearLayout
            android:id="@+id/snaptube_video_preview_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/snaptube_video_thumbnail"
                android:layout_width="74dp"
                android:layout_height="48dp"
                android:background="#24242A"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.VidSnap.Thumbnail" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/snaptube_video_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Loading video details..."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/snaptube_video_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Please wait..."
                    android:textColor="#8E8E93"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shimmer Loading Indicator -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/snaptube_shimmer_formats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="120dp"
                    android:layout_height="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="#2C2C34" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="8dp"
                    android:background="#24242A" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="16dp"
                    android:background="#24242A" />

                <View
                    android:layout_width="120dp"
                    android:layout_height="14dp"
                    android:layout_marginBottom="12dp"
                    android:background="#2C2C34" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="8dp"
                    android:background="#24242A" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="#24242A" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Main Formats Content Container -->
        <LinearLayout
            android:id="@+id/snaptube_formats_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Music -->
            <TextView
                android:id="@+id/snaptube_section_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:text="Music"
                android:textColor="#8E8E93"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/container_music_formats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:orientation="vertical" />

            <!-- Section 2: Video -->
            <TextView
                android:id="@+id/snaptube_section_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="4dp"
                android:text="Video"
                android:textColor="#8E8E93"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/container_video_formats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:orientation="vertical" />

            <!-- More formats row matching Screenshot 2 -->
            <RelativeLayout
                android:id="@+id/row_more_formats"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="More formats"
                    android:textColor="#C8C8D0"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/tv_more_formats_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="All  >"
                    android:textColor="#8E8E93"
                    android:textSize="13.5sp" />
            </RelativeLayout>

            <!-- Expanded formats container -->
            <LinearLayout
                android:id="@+id/container_extra_formats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Big Yellow Download Button matching Screenshot 2 -->
        <Button
            android:id="@+id/btn_snaptube_download"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFC83B"
            android:elevation="4dp"
            android:text="Download"
            android:textColor="#121214"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="25dp" />

        <!-- Hidden Compatibility Elements for YTDLnis background functions -->
        <LinearLayout
            android:id="@+id/compat_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <TextView android:id="@+id/bottom_sheet_title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/bottom_sheet_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <com.facebook.shimmer.ShimmerFrameLayout android:id="@+id/shimmer_loading_title" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <TextView android:id="@+id/bottom_sheet_loading_title" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </com.facebook.shimmer.ShimmerFrameLayout>
            <com.facebook.shimmer.ShimmerFrameLayout android:id="@+id/shimmer_loading_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content">
                <View android:layout_width="1dp" android:layout_height="1dp"/>
            </com.facebook.shimmer.ShimmerFrameLayout>
            <Button android:id="@+id/bottomsheet_schedule_button" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/bottomsheet_download_button" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <com.google.android.material.tabs.TabLayout android:id="@+id/download_tablayout" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <androidx.viewpager2.widget.ViewPager2 android:id="@+id/download_viewpager" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/bottom_sheet_link" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/bottomsheet_incognito" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <Button android:id="@+id/update_item" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>